# Production backend environment. Never commit real secrets.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=emilio2026.pythonanywhere.com
CORS_ALLOWED_ORIGINS=https://marketplace-tau-sand.vercel.app
TIME_ZONE=Africa/Nairobi
DB_ENGINE=sqlite
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_MAX_IMAGE_BYTES=10485760
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=
