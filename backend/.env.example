DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=emilio2026.pythonanywhere.com
CORS_ALLOWED_ORIGINS=https://marketplace.co.ke,https://www.marketplace.co.ke
TIME_ZONE=Africa/Nairobi
DB_ENGINE=sqlite

# Required for image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=

# Application-side maximum image size (10 MiB)
CLOUDINARY_MAX_IMAGE_BYTES=10485760

# Email verification / SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Marketplace <your-email@example.com>
