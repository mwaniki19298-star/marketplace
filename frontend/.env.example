# Base URL of the Django API. In local dev this is proxied by Vite (see
# vite.config.ts) so the browser only ever calls same-origin /api/*.
VITE_API_BASE_URL=/api

# Only used by vite.config.ts's dev proxy target.
VITE_API_PROXY_TARGET=http://localhost:8000

# Public Google OAuth client ID (safe to expose in the frontend).
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
