# Base URL of the Django API. In local dev this is proxied by Vite (see
# vite.config.ts) so the browser only ever calls same-origin /api/*.
VITE_API_BASE_URL=/api

# Only used by vite.config.ts's dev proxy target.
VITE_API_PROXY_TARGET=http://localhost:8000

# Google OAuth client IDs from Google Cloud Console.
# Create separate OAuth clients for Web, Android, and iOS.
# The backend accepts all three through GOOGLE_CLIENT_IDS.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com

# Django API URL reachable from the device. For a physical phone use your PC LAN IP, not 127.0.0.1.
EXPO_PUBLIC_API_BASE_URL=https://emilio2026.pythonanywhere.com

# Public HTTPS URL used for shareable listing links. Example: https://marketplace.example.com
EXPO_PUBLIC_WEB_BASE_URL=https://YOUR_MARKETPLACE_DOMAIN
# Hostname only, without https://
EXPO_PUBLIC_WEB_DOMAIN=YOUR_MARKETPLACE_DOMAIN
# Stable native identifiers for production builds
EXPO_PUBLIC_ANDROID_PACKAGE=com.marketplace.mobile
EXPO_PUBLIC_IOS_BUNDLE_ID=com.marketplace.mobile

# Cloudinary DIRECT mobile uploads. These are public values; NEVER put the
# Cloudinary API secret in the mobile app. Create an UNSIGNED upload preset
# in Cloudinary and restrict it to image uploads (JPEG/PNG/WEBP) and a
# reasonable size limit.
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset
