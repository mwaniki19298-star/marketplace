# Local development public client configuration
# These values are safe to use locally; do not put private secrets here.
# Vite web frontend uses localhost:5173. Android EAS development uses 10.0.2.2 in eas.json
# because 10.0.2.2 maps to the host machine from the Android emulator.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
EXPO_PUBLIC_WEB_BASE_URL=http://localhost:5173
EXPO_PUBLIC_WEB_DOMAIN=localhost:5173
MARKETPLACE_WEB_DOMAIN=localhost:5173
EXPO_PUBLIC_ANDROID_PACKAGE=com.marketplace.mobile
EXPO_PUBLIC_IOS_BUNDLE_ID=com.marketplace.mobile

# Cloudinary unsigned upload configuration
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=znbilq3o
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=marketplace_uploads

# Google OAuth client IDs
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=126323121709-2o26001nft4fkp19fl4l9k8jvmma6t4a.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=126323121709-0kno4eo9u786kvbd188aln1b5bhqmefg.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
